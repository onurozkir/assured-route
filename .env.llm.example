# Copy to .env, then fill the two model IDs and API keys. No keys belong in requests.
AR_PROVIDER_MODE=openai_compatible
AR_CHEAP_MODEL=your-cheap-model-id
AR_CHEAP_API_KEY=
AR_CHEAP_BASE_URL=https://api.openai.com/v1
AR_EXPENSIVE_MODEL=your-expensive-model-id
AR_EXPENSIVE_API_KEY=
AR_EXPENSIVE_BASE_URL=https://api.openai.com/v1

# Both APIs must implement the Chat Completions contract with Bearer authentication.
# If JSON mode is unsupported, use 'none'; the application still parses/validates JSON.
AR_CHEAP_RESPONSE_FORMAT=json_object
AR_EXPENSIVE_RESPONSE_FORMAT=json_object
# Older compatible providers may require max_tokens instead.
AR_CHEAP_TOKEN_LIMIT_PARAMETER=max_completion_tokens
AR_EXPENSIVE_TOKEN_LIMIT_PARAMETER=max_completion_tokens
AR_LLM_MAX_OUTPUT_TOKENS=1024
AR_LLM_MAX_RESPONSE_BYTES=262144

# Illustrative estimates: replace with your own observed cost/latency assumptions.
# In live mode, verifier calls use the expensive model and its estimated cost.
AR_CHEAP_COST_USD=0.0015
AR_EXPENSIVE_COST_USD=0.015
AR_POLICY__CHEAP_TIMEOUT_MS=4000
AR_POLICY__PROVIDER_TIMEOUT_MS=12000
AR_POLICY__CHEAP_EXPECTED_MS=500
AR_POLICY__EXPENSIVE_EXPECTED_MS=2000
AR_POLICY__VERIFIER_EXPECTED_MS=2000
AR_POLICY__RESPONSE_RESERVE_MS=100
AR_POLICY__ENABLE_VERIFIER=true
AR_POLICY__REQUIRE_VERIFIER=false
AR_POLICY__FORCE_EXPENSIVE=false
AR_LOG_LEVEL=INFO
