# Copy to .env. No external API key is needed for mock providers.
AR_PROVIDER_MODE=mock
# For real APIs, copy .env.llm.example instead and set both model IDs and keys.
AR_LOG_LEVEL=INFO
AR_CHEAP_COST_USD=0.0015
AR_EXPENSIVE_COST_USD=0.015
AR_VERIFIER_COST_USD=0.0003
AR_MOCK_CHEAP_DELAY_MS=10
AR_MOCK_EXPENSIVE_DELAY_MS=30
AR_MOCK_VERIFIER_DELAY_MS=5

AR_POLICY__VERSION=heuristic-v1
AR_POLICY__ACCEPT_RISK_MAX=0.25
AR_POLICY__FORCE_EXPENSIVE=false
AR_POLICY__ENABLE_VERIFIER=true
AR_POLICY__REQUIRE_VERIFIER=false
AR_POLICY__LOW_OCR_THRESHOLD=0.8
AR_POLICY__MAX_CHEAP_PAGES=3
AR_POLICY__MAX_CHEAP_CHARS=12000
AR_POLICY__FUZZY_NAME_THRESHOLD=0.92
AR_POLICY__RESPONSE_RESERVE_MS=20
AR_POLICY__CHEAP_EXPECTED_MS=80
AR_POLICY__EXPENSIVE_EXPECTED_MS=250
AR_POLICY__VERIFIER_EXPECTED_MS=40
AR_POLICY__PROVIDER_TIMEOUT_MS=1000
